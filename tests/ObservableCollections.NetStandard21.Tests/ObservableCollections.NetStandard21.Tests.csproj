<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Runs the same test suite as ObservableCollections.Tests, but against the netstandard2.1
    compilation of the library instead of the net* one. That asset is the only place where the
    Unsafe.As-based shims in Shims/CollectionsMarshalEx.cs and Shims/Collections.cs survive,
    and it is the asset Unity consumes, so it needs runtime coverage of its own.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="FluentAssertions" Version="6.0.0-beta0001" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.0" />
    <PackageReference Include="xunit" Version="2.4.1" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.4.3">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <!-- SetTargetFramework forces the netstandard2.1 asset instead of letting NuGet pick net10.0. -->
    <ProjectReference Include="..\..\src\ObservableCollections\ObservableCollections.csproj"
                     SetTargetFramework="TargetFramework=netstandard2.1" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\ObservableCollections.Tests\**\*.cs"
             Exclude="..\ObservableCollections.Tests\bin\**\*.cs;..\ObservableCollections.Tests\obj\**\*.cs"
             LinkBase="ObservableCollections.Tests" />
  </ItemGroup>

</Project>
